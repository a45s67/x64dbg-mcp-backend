{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "X64DBG_ROOT": "$env{X64DBG_ROOT}"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "windows-x86",
      "inherits": "windows-base",
      "architecture": { "value": "x86", "strategy": "external" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64" },
    { "name": "windows-x86-release", "configurePreset": "windows-x86" }
  ]
}
